{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Laplace modular browser API",
    "version": "1.0.0",
    "description": "Implemented IIS browser boundary over the native Laplace reader. Entity identity and physicality semantics remain native-owned. Shared sign-in is discovered through runtime.js identityPath."
  },
  "servers": [
    {
      "url": ".",
      "description": "Relative to this installed modular application"
    }
  ],
  "paths": {
    "/api/schema": {
      "get": {
        "summary": "Discover native view projections, mask fields, occurrence roles and permitted operation schemas",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewSchema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "summary": "Read exact counts and the connected database identity",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "database",
                    "entities",
                    "physicalities",
                    "database_bytes",
                    "as_of"
                  ],
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "entities": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "physicalities": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "database_bytes": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "registered_witness_rows": {
                      "type": "string",
                      "description": "Registry rows; not a census of source trunks"
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/library": {
      "get": {
        "summary": "Browse stored source and file trunks by canonical ID cursor",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "tier": {
                            "type": "integer"
                          },
                          "metadata": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                          },
                          "content": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                          },
                          "children": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{32}$"
                            }
                          }
                        }
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      }
    },
    "/api/lookup": {
      "get": {
        "summary": "Resolve text or an ID and read its physicality, containing paths and attestations",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Content or canonical ID, up to 4096 UTF-8 bytes"
            }
          }
        ]
      }
    },
    "/api/resources/{id}": {
      "get": {
        "summary": "Read canonical content by ID",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      }
    },
    "/api/provenance/{id}": {
      "get": {
        "summary": "Trace bounded containment ancestry through records, files and source trunks",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "complete": {
                      "type": "boolean"
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "limits": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      }
    },
    "/api/sources": {
      "get": {
        "summary": "Read source registration metadata",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Registry metadata remains distinct from physical source trunks discovered through /api/library."
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/surface": {
      "get": {
        "summary": "Discover the underlying native service routes",
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/operations/{operation}": {
      "post": {
        "summary": "Execute a permitted native read operation",
        "parameters": [
          {
            "name": "operation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "embeddings",
                "forward",
                "shape"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "other": {
                    "type": "string",
                    "description": "Required for shape; up to 4096 UTF-8 bytes per field"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native read result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Native result; the operation input schema is discovered from /api/schema."
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Invalid input or unavailable native reader",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Facet": {
        "type": "object",
        "properties": {
          "bank": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "encoding": {
            "enum": [
              "flags",
              "enum"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "integer"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Vertex": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "ordinal": {
            "type": "integer"
          },
          "position": {
            "type": "integer"
          },
          "run": {
            "type": "integer",
            "minimum": 1
          },
          "said": {
            "type": "integer",
            "description": "Occurrence role decoded by /api/schema vertex_roles"
          },
          "outcome": {
            "type": "integer"
          },
          "spare": {
            "type": "integer"
          }
        }
      },
      "Physicality": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "integer"
          },
          "n": {
            "type": "integer"
          },
          "mask": {
            "type": "string"
          },
          "claim": {
            "type": "boolean"
          },
          "constituents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          "vertices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vertex"
            }
          },
          "facets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Facet"
            }
          }
        }
      },
      "Resource": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "recorded",
          "physicality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "tier": {
            "type": "integer",
            "description": "Stored tier when present; computed text modality tier otherwise"
          },
          "stored_tier": {
            "type": [
              "integer",
              "null"
            ]
          },
          "computed_tier": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Computed for text input; null for ID-only reads"
          },
          "storage": {
            "enum": [
              "database",
              "tier0-cache",
              "highway-cache",
              "computed",
              "unresolved"
            ]
          },
          "recorded": {
            "type": "boolean"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          "parts_total": {
            "type": "integer"
          },
          "parts_complete": {
            "type": "boolean"
          },
          "physicality": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Physicality"
            }
          },
          "entity_facets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Facet"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "attestations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "canonical_tier": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Tier computed from available canonical content, including mapped identifiers"
          },
          "cache_tier": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Tier recorded in the selected perf-cache, independently of database metadata"
          }
        }
      },
      "ViewSchema": {
        "type": "object",
        "properties": {
          "schema": {
            "const": "laplace-view-schema/v1"
          },
          "highway": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity": {
            "type": "object"
          },
          "views": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "banks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "vertex_roles": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "inputSchema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
