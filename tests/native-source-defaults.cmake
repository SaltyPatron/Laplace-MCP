# Compile a real consumer through the production Native source selector.
foreach(required SOURCE WORK)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing source-selection setting ${required}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}/project" "${WORK}/Native first" "${WORK}/Native second" "${WORK}/Laplace-Native")
file(WRITE "${WORK}/Native first/native_choice.h" "#define NATIVE_CHOICE 17\n")
file(WRITE "${WORK}/Native second/native_choice.h" "#define NATIVE_CHOICE 23\n")
file(WRITE "${WORK}/Laplace-Native/native_choice.h" "#define NATIVE_CHOICE 99\n")
file(WRITE "${WORK}/project/main.c" "#include <stdio.h>\n#include <native_choice.h>\nint main(void) { printf(\"%d\\n\", NATIVE_CHOICE); return 0; }\n")
file(WRITE "${WORK}/project/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(NativeSourceSelection C)
if(DEFINED PARENT_NATIVE)
  set(LAPLACE_NATIVE "${PARENT_NATIVE}")
endif()
include("${SELECTION_MODULE}")
add_executable(consumer main.c)
target_include_directories(consumer PRIVATE "${LAPLACE_NATIVE}")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/executable.txt" CONTENT "$<TARGET_FILE:consumer>")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/selected.txt" CONTENT "@LAPLACE_NATIVE@\n" @ONLY)
]=])
function(configure profile selected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "--unset=LAPLACE_NATIVE"
    "LAPLACE_NATIVE=${selected}" "${CMAKE_COMMAND}" -S "${WORK}/project" -B "${WORK}/${profile}" -G Ninja
    "-DSELECTION_MODULE=${SOURCE}/cmake/LaplaceNative.cmake" ${ARGN}
    WORKING_DIRECTORY "${WORK}" COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
endfunction()
function(build profile expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/${profile}"
    COMMAND_ERROR_IS_FATAL ANY OUTPUT_VARIABLE build_output)
  file(READ "${WORK}/${profile}/executable.txt" executable)
  execute_process(COMMAND "${executable}" COMMAND_ERROR_IS_FATAL ANY
    OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT value STREQUAL "${expected}")
    message(FATAL_ERROR "${profile}: selected consumer returned ${value}, expected ${expected}")
  endif()
  set(last_build "${build_output}" PARENT_SCOPE)
endfunction()

configure(defaults "${WORK}/Native first")
build(defaults 17)
configure(defaults "${WORK}/Native second")
build(defaults 23)
file(STRINGS "${WORK}/defaults/CMakeCache.txt" leaked REGEX "^LAPLACE_NATIVE:")
if(leaked)
  message(FATAL_ERROR "Environment default became a persistent override: ${leaked}")
endif()
file(TIMESTAMP "${WORK}/defaults/selected.txt" before "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
configure(defaults "${WORK}/Native second")
build(defaults 23)
file(TIMESTAMP "${WORK}/defaults/selected.txt" after "%s" UTC)
if(NOT before STREQUAL after OR NOT last_build MATCHES "ninja: no work to do\\.")
  message(FATAL_ERROR "Unchanged source selection rewrote configuration or rebuilt the consumer")
endif()
configure(pinned "${WORK}/Native first" "-DLAPLACE_NATIVE:PATH=${WORK}/Native first")
build(pinned 17)
configure(pinned "${WORK}/Native second")
build(pinned 17)
configure(pinned "${WORK}/Native second" -ULAPLACE_NATIVE)
build(pinned 23)
configure(parent "${WORK}/Native first" "-DPARENT_NATIVE=${WORK}/Native second" "-DLAPLACE_NATIVE:PATH=${WORK}/Native first")
build(parent 23)
configure(sibling "")
build(sibling 99)
configure(relative "${WORK}/Native second" "-DLAPLACE_NATIVE=Native first")
build(relative 17)
configure(relative "${WORK}/Native second")
build(relative 17)
configure(relative "${WORK}/Native second" -ULAPLACE_NATIVE)
build(relative 23)
message(STATUS "Native source defaults follow the environment; explicit/parent choices persist; unchanged builds do no work")
